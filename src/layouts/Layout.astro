---
import Header from "@/components/Header.astro";
import "../styles/global.css";
import "@fontsource-variable/onest";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="description"
      content="Citricode - Soluciones digitales frescas para tu negocio"
    />
    <meta
      name="keywords"
      content="Citricode, soluciones digitales, innovación, tecnología, dashboard, ERP, ERM"
    />
    <title>Citricode</title>

    <!-- Etiquetas Open Graph -->
    <meta property="og:title" content="Citricode" />
    <meta
      property="og:description"
      content="Citricode - Soluciones digitales frescas para tu negocio"
    />
    <meta property="og:image" content="/citricode-logo.webp" />
    <meta property="og:url" content="https://citricode-portfolio.vercel.app/" />
    <meta property="og:type" content="website" />
  </head>
  <body class="bg-[#fff7ed] md:bg-gradient-to-b from-[#fff7ed] to-[#fefeff]">
    <Header />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: "Onest Variable", sans-serif;
  }
</style>
