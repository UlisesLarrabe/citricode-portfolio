<div
  class="p-2 border flex justify-center flex-col border-gray-300 rounded-lg min-w-3xs min-h-32 gap-2 w-full md:w-1/3"
>
  <h2 class="text-2xl font-semibold">Filtros</h2>
  <div class="flex flex-col gap-2">
    <label class="text-sm font-semibold" for="date"> Fecha </label>
    <input
      type="date"
      name="date"
      id="date"
      class="p-2 border border-gray-300 rounded-lg"
      value={new Date().toISOString().split("T")[0]}
    />
    <label class="text-sm font-semibold" for="type"> Tipo </label>
    <select name="type" id="type" class="p-2 border border-gray-300 rounded-lg">
      <option value="income">Ingreso</option>
      <option value="outcome">Egreso</option>
    </select>
    <label class="text-sm font-semibold" for="paymentMethod">
      Método de pago
    </label>
    <select
      name="paymentMethod"
      id="paymentMethod"
      class="p-2 border border-gray-300 rounded-lg"
    >
      <option value="all">Todos</option>
      <option value="cash">Efectivo</option>
      <option value="card">Tarjeta</option>
      <option value="mercado_pago">Mercado Pago</option>
    </select>
    <label class="text-sm font-semibold" for="local"> Local </label>
    <select
      name="local"
      id="local"
      class="p-2 border border-gray-300 rounded-lg"
    >
      <option value="all">Todos</option>
      <option value="Local 1">Local 1</option>
      <option value="Local 2">Local 2</option>
    </select>
  </div>
  <button
    type="button"
    class="bg-blue-500 text-white p-2 rounded-lg cursor-pointer hover:bg-blue-400"
  >
    Filtrar
  </button>
</div>
