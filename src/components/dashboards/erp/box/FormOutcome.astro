<section class="flex flex-col justify-center items-center gap-4">
  <div class="border border-eerie-black p-4 rounded-lg">
    <div>
      <h2 class="text-3xl font-semibold">Retiro de Efectivo</h2>
      <p class="text-gray-700">
        Complete el formulario para registrar un retiro de dinero en la caja
      </p>
    </div>

    <form class="flex flex-col gap-4 w-full">
      <label class="flex flex-col gap-2">
        <span class="font-medium">Local</span>
        <select
          class="border border-eerie-black rounded-lg p-2"
          name="local"
          value={"Local 1"}
        >
          <option value="Local 1">Local 1</option>
          <option value="Local 2">Local 2</option>
        </select>
      </label>
      <label class="flex flex-col gap-2">
        <span class="font-medium">Monto a retirar ($)</span>
        <input
          type="number"
          placeholder="0"
          class="border border-eerie-black rounded-lg p-2"
          min={0}
          value={0}
        />
      </label>
      <label class="flex flex-col gap-2">
        <span class="font-medium">Motivo del retiro</span>
        <textarea
          placeholder="Describa el motivo del retiro"
          class="border border-eerie-black rounded-lg p-2 field-sizing-content resize-none"
          value={""}></textarea>
      </label>

      <button
        type="submit"
        disabled={false}
        class="bg-eerie-black text-white px-4 py-2 rounded-lg cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Registrar retiro
      </button>
    </form>
  </div>
</section>
