---
import SummaryArticleERP from "./SummaryArticleERP.astro";
import ReceiptIconERP from "./icons/ReceiptIconERP.astro";
import MercadoPagoERP from "./icons/MercadoPagoERP.astro";
import CashIconERP from "./icons/CashIconERP.astro";
import CardIconERP from "./icons/CardIconERP.astro";

const total_in = 250000;
const total_out = 50000;
const mercadopagoQuantity = 20;
const cashQuantity = 14;
const cardQuantity = 16;
---

<section class="flex flex-col md:flex-row w-full min-h-28 gap-4">
  <SummaryArticleERP
    title="Ganancias totales"
    price={total_in}
    info={`Después de retiros $${total_in - total_out}`}
  >
    <ReceiptIconERP />
  </SummaryArticleERP>

  <SummaryArticleERP
    title="Ventas totales con Mercado Pago"
    price={mercadopagoQuantity}
    isNotPrice={true}
  >
    <MercadoPagoERP />
  </SummaryArticleERP>
  <SummaryArticleERP
    title="Ventas totales en efectivo"
    price={cashQuantity}
    isNotPrice={true}
  >
    <CashIconERP />
  </SummaryArticleERP>

  <SummaryArticleERP
    title="Ventas totales con tarjeta"
    price={cardQuantity}
    isNotPrice={true}
  >
    <CardIconERP />
  </SummaryArticleERP>
</section>
