---
interface Props {
  title: string;
  price: number | string;
  isNotPrice?: boolean;
  info?: string;
}

const { title, price, isNotPrice, info } = Astro.props;
---

<article class="w-full p-4 border border-gray-300 rounded-md md:w-1/4">
  <div class="flex justify-between">
    <h3>{title}</h3>
    <slot />
  </div>
  <p class="font-bold text-2xl">
    {isNotPrice ? "" : "$"}
    {price}
  </p>
  {info && <p class="text-small text-gray-500">{info}</p>}
</article>
