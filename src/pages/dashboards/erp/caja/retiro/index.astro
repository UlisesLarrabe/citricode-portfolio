---
import GoBackSection from "@/components/dashboards/erp/GoBackSection.astro";
import HeaderERP from "@/components/dashboards/erp/HeaderERP.astro";
import FormOutcome from "@/components/dashboards/erp/box/FormOutcome.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="bg-[#fefffe] h-[calc(100vh-56px)]">
    <HeaderERP />
    <main class="w-full flex flex-col p-4 gap-4">
      <GoBackSection
        href="/dashboards/erp/caja"
        title="Registrar retiro de caja"
      />

      <FormOutcome />
    </main>
  </div>
</Layout>
