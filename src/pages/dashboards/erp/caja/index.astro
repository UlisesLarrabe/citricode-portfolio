---
import HeaderERP from "@/components/dashboards/erp/HeaderERP.astro";
import TitlePagesERP from "@/components/dashboards/erp/TitlePagesERP.astro";
import MoneySummaryERP from "@/components/dashboards/erp/MoneySummaryERP.astro";
import BoxFiltersERP from "@/components/dashboards/erp/box/BoxFiltersERP.astro";
import TableBoxERP from "@/components/dashboards/erp/box/TableBoxERP.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="bg-[#fefffe] h-[calc(100vh-56px)]">
    <HeaderERP />
    <main class="w-full flex flex-col p-4 gap-4">
      <TitlePagesERP
        title="Arqueo de caja"
        href="/dashboards/erp/caja/retiro"
        button="Registrar retiro"
      />
      <MoneySummaryERP />
      <section class="flex flex-col md:flex-row gap-4 justify-center">
        <BoxFiltersERP />
        <TableBoxERP />
      </section>
    </main>
  </div>
</Layout>
